# Copy to .env and fill in with a Supabase project that has every migration
# in supabase/migrations applied (and, for local development, supabase/seed.sql).
#
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# The URL must be the full https:// address (e.g. https://abcdefghij.supabase.co) —
# not just the project ref, and with no surrounding quotes.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
