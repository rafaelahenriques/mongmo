# Copy to .env for local development. Never commit .env.
#
# Builds don't read this file: each EAS environment (development, preview
# for staging, production) has its own values on expo.dev. See
# docs/DEPLOYMENT.md. To run the app locally against staging instead,
# `eas env:pull --environment preview` writes them to .env.local.

# development | staging | production. Picks the app's name and id, and
# staging and production refuse a plain-http Supabase URL.
EXPO_PUBLIC_APP_ENV=development

# Supabase project with every migration in supabase/migrations applied
# (and, for local development, supabase/seed.sql).
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# The URL must be the full https:// address (e.g. https://abcdefghij.supabase.co) —
# not just the project ref, and with no surrounding quotes.
# Only ever the anon / publishable key here: the app refuses to start with
# the service_role (secret) key, which bypasses every security rule.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Crash reporting (Sentry project → Settings → Client Keys). Leave empty to
# keep it off, as it is in local development.
EXPO_PUBLIC_SENTRY_DSN=

# Paying online (Stripe Dashboard → Developers → API keys): the publishable
# key only, pk_test_… outside production, pk_live_… in it. Leave empty to
# offer pay at pickup only. The secret key goes in the Supabase function
# secrets, never here (docs/DEPLOYMENT.md → Online payment).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Android's map (Google Maps). Not EXPO_PUBLIC_: only the build uses it, and
# only for Android; iOS uses Apple Maps. Leave empty for a drawn map instead.
# How to make the key: docs/DEPLOYMENT.md → The Android map key.
GOOGLE_MAPS_ANDROID_API_KEY=
